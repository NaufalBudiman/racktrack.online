# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Random secret for Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local only: email of the Google account that should receive the seed data (scripts/seed.ts)
SEED_OWNER_EMAIL=

# Daily email digest (Vercel Cron + Resend). Without RESEND_API_KEY the cron only dry-runs.
CRON_SECRET=
RESEND_API_KEY=
# Optional, defaults to "RackTrack <noreply@racktrack.online>"
DIGEST_FROM=
